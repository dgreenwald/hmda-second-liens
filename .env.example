# Copy to .env and adjust for your environment. Loaded by the Makefile
# (`include .env`) and exported to every pipeline script.

# Root containing the source-specific raw/ and parquet/ trees managed by
# py_tools.datasets.hmda. Defaults to $PY_TOOLS_DATA_DIR/hmda when that
# variable is set, otherwise <repo>/data/raw/hmda.
# HMDA_SECONDS_HMDA_DATA_DIR=/data/hmda

# Legacy flat hmda<year>.parquet cache used only by the streaming audit
# commands that have not yet migrated to hmda.load().
# HMDA_SECONDS_YEARLY_DIR=/data/hmda/save

# Large, regenerable intermediate files (concatenated training extract,
# per-year classified outputs) are written outside the repo. Defaults to
# <repo>/data/intermediate if unset. Override to use a local scratch/data
# volume instead, e.g.:
# HMDA_SECONDS_EXTERNAL_DIR=/data/hmda_seconds

# Root for fitted models, tables, Slurm manifests/logs, and other regenerable
# outputs. Defaults to <repo>/output.
# HMDA_SECONDS_OUTPUT_DIR=/data/hmda_seconds/output

# Optional defaults used by the raw-logistic Slurm generator. CLI arguments
# override these values when supplied.
# HMDA_SECONDS_SLURM_ACTIVATE=/path/to/venv/bin/activate
# HMDA_SECONDS_SLURM_ACCOUNT=torch_pr_609_general
# HMDA_SECONDS_SLURM_TIME=8:00:00
# HMDA_SECONDS_SLURM_MEMORY=32G
# HMDA_SECONDS_SLURM_MAX_CONCURRENT=8

# Zillow county-ZHVI source vintage (YYYYMM). The default is pinned in
# config.py; override only to run an explicit source-vintage robustness check.
# HMDA_SECONDS_ZILLOW_VINTAGE=202608
