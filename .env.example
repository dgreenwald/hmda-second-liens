# Copy to .env and adjust for your environment. Loaded automatically by
# py_tools.datasets.config (searched upward from the current working
# directory) and by the Makefile.

# Base data directory for py_tools dataset loaders (FHFA, etc). See
# py_tools.datasets.config.base_dir().
PY_TOOLS_DATA_DIR=./data/raw

# Directory holding one cleaned HMDA extract per year, named hmda<year>.parquet,
# in the same format produced by py_tools.datasets.hmda.load_hmda (see
# data/README.md for how these are built from raw LAR files). Defaults to
# <repo>/data/raw/hmda/save if unset. Override to point at an
# already-materialized local cache, e.g.:
# HMDA_SECONDS_YEARLY_DIR=/data/hmda/save/
